# FloodCast Frontend Environment Variables

# Backend FastAPI URL (Deployed Render / Railway / Fly URL in production)
NEXT_PUBLIC_API_URL="https://hackware-flood-engine-backend.onrender.com"

# Supabase Auth & Database Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Optional Mapbox Token (Leave blank to use built-in high-performance CartoDB/OpenStreetMap basemap)
NEXT_PUBLIC_MAPBOX_TOKEN=""
